# Base URL the browser uses for the REST API (see api/API.md). The API is served by
# this same app, so the same-origin default /api/v1 is right unless you point at a remote API.
NEXT_PUBLIC_API_URL=/api/v1

# Razorpay credentials for clinic monthly subscription payments.
# KEY_ID is also exposed to the browser (NEXT_PUBLIC_) to open the Checkout
# widget - it is a public identifier, not a secret. KEY_SECRET stays server-only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# Backend API (api/)
# ---------------------------------------------------------------------------
# Database (MySQL / Aiven)
# e.g. mysql://user:password@localhost:3306/medinexa_db
DATABASE_URL=

# DATABASE_URL=
# JWT signing secret for access tokens (and refresh-token/invite/OTP hashing salt source)
JWT_SECRET=

# HMAC secret used to sign time-limited file URLs
FILE_SIGNING_SECRET=

# Public base URL used to build signed file URLs (no trailing slash)
APP_URL=

# Base URL used to build password reset links in forgot-password emails (no trailing slash)
RESET_PASSWORD_URL=

# email service provider (brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

CLOUDINARY_URL=

# Firebase Cloud Messaging (push notifications) — service account for project jido-62f48.
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Cloud Messaging (push notifications) — service account for project jido-clinic,
# used by the xclinic (clinic-side) app only. Separate project/credentials from the
# patient-app FIREBASE_* vars above since device tokens are only valid within the
# project that issued them.
FIREBASE_CLINIC_PROJECT_ID=
FIREBASE_CLINIC_CLIENT_EMAIL=
FIREBASE_CLINIC_PRIVATE_KEY=

SUBSCRIPTION_PAYMENT_SECRET=

# Razorpay credentials for clinic monthly subscription payments (same account as the UI's NEXT_PUBLIC_RAZORPAY_KEY_ID).
WEBHOOK_SECRET=
CRON_SECRET=

# Jido SMS Gateway (Basic auth token: base64 of "user:pass"). Optional SMS_API_URL override.
SMS_API_KEY=

# WAHA (WhatsApp HTTP API — see whatsapp.md). Optional WAHA_BASE_URL/WAHA_SESSION overrides.
WAHA_API_KEY=
WAHA_BASE_URL=
WAHA_SESSION=
